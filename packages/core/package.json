{
  "name": "@tokseal/core",
  "version": "0.2.0",
  "description": "Local-first parser, pricing, aggregation, and grading for AI coding token usage.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "sync-pricing": "node scripts/sync-pricing.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LenChoi/tokseal.git"
  },
  "homepage": "https://github.com/LenChoi/tokseal#readme",
  "bugs": {
    "url": "https://github.com/LenChoi/tokseal/issues"
  },
  "author": "Choi Minho <https://github.com/LenChoi>",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "claude-code",
    "codex",
    "gemini-cli",
    "tokens",
    "usage",
    "cost",
    "badge",
    "svg"
  ],
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.4.1"
  }
}
