{
  "name": "tokseal",
  "version": "0.2.5",
  "description": "Seal your AI coding usage into a GitHub badge. Local-first token stats, a grade, and a shareable card \u2014 your data never leaves your machine.",
  "type": "module",
  "bin": {
    "tokseal": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build && cp ../../README.md ./README.md"
  },
  "keywords": [
    "ai",
    "claude",
    "claude-code",
    "codex",
    "gemini",
    "tokens",
    "usage",
    "badge",
    "github-readme",
    "cli",
    "llm",
    "cost",
    "contribution-graph"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LenChoi/tokseal.git"
  },
  "homepage": "https://github.com/LenChoi/tokseal#readme",
  "bugs": {
    "url": "https://github.com/LenChoi/tokseal/issues"
  },
  "author": "Choi Minho <https://github.com/LenChoi>",
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.4.1",
    "@tokseal/core": "^0.2.0",
    "tsup": "^8.5.1"
  }
}
